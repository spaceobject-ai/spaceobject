{
  "include": ["src/**/*.ts", "tests/**/*.ts", "vite.config.ts", "worker-configuration.d.ts"],
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "isolatedModules": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
